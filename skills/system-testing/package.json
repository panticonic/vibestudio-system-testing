{
  "name": "@workspace-skills/system-testing",
  "version": "0.1.0",
  "description": "Automated system testing via headless agentic sessions",
  "type": "module",
  "vibestudio": {
    "authority": {
      "requests": [
        {
          "capability": "workspace-service:missions",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:images",
          "resource": {
            "kind": "exact",
            "key": "do:workers/images:ImagesDO:workspace"
          },
          "tier": "gated",
          "evidence": "exact"
        }
      ],
      "serviceRequests": [
        {
          "protocol": "vibestudio.development.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.models.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.missions.v1",
          "availability": "required"
        },
        {
          "protocol": "vibestudio.images.v1",
          "availability": "required"
        }
      ],
      "provides": []
    }
  },
  "exports": {
    ".": "./index.ts",
    "./cli": "./cli.ts",
    "./deterministic": "./deterministic.ts",
    "./diagnostics": "./diagnostics.ts",
    "./record-analysis": "./record-analysis.ts",
    "./report": "./messages/report.ts",
    "./runner": "./runner.ts",
    "./scenario-validation": "./scenario-validation.ts",
    "./stages": "./stages.ts",
    "./test-runner": "./test-runner.ts",
    "./tests/*": "./tests/*.ts"
  },
  "dependencies": {
    "@vibestudio/content-addressing": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@vibestudio/shell-core": "workspace:*",
    "@vibestudio/trajectory-identity": "workspace:*",
    "@workspace/agentic-session": "workspace:*",
    "@workspace/agentic-core": "workspace:*",
    "@workspace/agentic-protocol": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/testkit": "workspace:*",
    "@workspace-skills/workspace-dev": "workspace:*",
    "@workspace-skills/vibestudio-vcs": "workspace:*",
    "@vibestudio/workspace": "workspace:*",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  }
}
